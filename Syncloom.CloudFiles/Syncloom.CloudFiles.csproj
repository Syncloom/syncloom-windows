<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows side of on-demand files: the Cloud Files API (cldapi.dll) through CsWin32. Needs Windows to run. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.106" PrivateAssets="all" />
    <ProjectReference Include="..\Syncloom.Sync\Syncloom.Sync.csproj" />
  </ItemGroup>
</Project>
