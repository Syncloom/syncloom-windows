<Page x:Class="Syncloom.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="16" Padding="32,24" MaxWidth="780" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Account" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="User" FontWeight="SemiBold" />
                    <TextBlock x:Name="Server" Opacity="0.7" />
                    <TextBlock x:Name="Storage" Opacity="0.7" />
                    <TextBlock x:Name="Folder" Opacity="0.7" />
                </StackPanel>
            </Border>
            <TextBlock Text="Two-step verification" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="Any one of your second factors signs you in. Add authenticator apps and security keys in the web app." Opacity="0.7" TextWrapping="Wrap" />
            <ItemsControl x:Name="Methods">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
                            <TextBlock Text="{x:Bind}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Sign out" Click="SignOut_Click" />
        </StackPanel>
    </ScrollViewer>
</Page>
