<Window x:Class="Syncloom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Syncloom">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid x:Name="TitleBar" Height="40" VerticalAlignment="Top" Canvas.ZIndex="10">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="Assets/Square44x44Logo.png" Width="18" Height="18" />
                <TextBlock Text="Syncloom" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <NavigationView x:Name="Nav" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Left"
                        OpenPaneLength="240" ItemInvoked="Nav_ItemInvoked" Margin="0,40,0,0" Visibility="Collapsed">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Files" Tag="files" Icon="Folder" IsSelected="True" />
                <NavigationViewItem Content="Shared with me" Tag="shared" Icon="People" />
                <NavigationViewItem Content="Trash" Tag="trash" Icon="Delete" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings" Icon="Setting" />
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
        <Frame x:Name="AuthFrame" Margin="0,40,0,0" />
    </Grid>
</Window>
